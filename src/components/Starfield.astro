---
// Arka plandaki 3B yıldız alanı (projenin ilk halindeki görünüm): yıldızlar sürekli sana doğru akar,
// açılışta hiperuzay sıçraması yapar, scroll'da hafifçe hızlanır (çizgileşmeden) ve yumuşakça
// seyir hızına döner. Bölüm geçişlerinde ışık hızı efekti yok (kullanıcı isteği).
//
// Performans: kullanıcının Opera'sında (RTX 3060) tam kalite fps'i düşürmüyor. Test Chrome'u Intel GPU'da
// çalıştığı için tam kaliteyi çok pahalı ölçmüştü; asıl ölçüt kullanıcının tarayıcısı. Bkz. NOTES.md.
---

<canvas id="starfield" aria-hidden="true"></canvas>
<div class="glow" aria-hidden="true"></div>

<style>
  #starfield {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    pointer-events: none;
    background: var(--bg);
  }
  /* Sağ üstteki tema rengindeki ışıma: sayfayla birlikte kayar, statik */
  .glow {
    position: absolute;
    top: 0;
    right: 0;
    width: min(1100px, 90vw);
    height: 900px;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse 60% 55% at 75% 0%, var(--accent-soft), transparent 70%);
  }
</style>

<script>
  type Star = { x: number; y: number; z: number; pz: number };

  // Tam kalite. Zayıf bir cihazda kasarsa önce RES'i 0.75, gerekirse SKIP'i 2 yap.
  const RES = 1; // canvas çözünürlük ölçeği (CSS ile ekrana büyütülür)
  const SKIP = 1; // her SKIP karede bir çiz
  const canvas = document.getElementById('starfield') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d', { alpha: false })!;
  const animate = document.documentElement.classList.contains('anim');

  const CRUISE = 0.0006; // seyir hızı: yıldızlar yavaşça yaklaşır
  const STREAK = 0.004; // bu hızın üstünde yıldızlar çizgiye döner (ışık hızı görüntüsü)
  const BUCKETS = 5;

  let w = 0;
  let h = 0;
  let stars: Star[] = [];
  let color = '255, 255, 255';
  let bg = '#05060a';
  let styles: string[] = [];
  const buckets: number[][] = Array.from({ length: BUCKETS }, () => []);

  let speed = animate ? 0.09 : 0; // açılışta hiperuzay hızıyla başla
  let boost = 0; // scroll hızından gelen itki
  let lastScrollY = window.scrollY;
  let frame = 0;
  let running = true;

  function readColors() {
    const css = getComputedStyle(document.documentElement);
    color = css.getPropertyValue('--star').trim() || color;
    bg = css.getPropertyValue('--bg').trim() || bg;
    styles = Array.from({ length: BUCKETS }, (_, i) => {
      const depth = (i + 0.5) / BUCKETS;
      return `rgba(${color}, ${Math.min(1, 0.15 + depth * 0.95).toFixed(2)})`;
    });
  }

  function spawn(s: Star, anywhere: boolean) {
    s.x = (Math.random() * 2 - 1) * w;
    s.y = (Math.random() * 2 - 1) * h;
    s.z = anywhere ? Math.random() : 1;
    s.pz = s.z;
  }

  function resize() {
    w = window.innerWidth;
    h = window.innerHeight;
    canvas.width = Math.round(w * RES);
    canvas.height = Math.round(h * RES);
    ctx.setTransform(RES, 0, 0, RES, 0, 0);
    const count = Math.min(700, Math.floor((w * h) / 2600)); // mobilde daha az
    stars = Array.from({ length: count }, () => {
      const s = { x: 0, y: 0, z: 0, pz: 0 };
      spawn(s, true);
      return s;
    });
  }

  // Yıldızları derinliğe göre gruplayıp her grubu tek path ile çiz (kare başına BUCKETS çizim çağrısı)
  function draw(v: number) {
    const cx = w / 2;
    const cy = h / 2;
    const streak = v > STREAK; // hızlıyken çizgi, yavaşken nokta
    for (const b of buckets) b.length = 0;

    for (const s of stars) {
      s.pz = s.z;
      s.z -= v;
      if (s.z <= 0.001) {
        spawn(s, false);
        continue;
      }
      const k = 0.25 / s.z;
      const x = cx + s.x * k;
      const y = cy + s.y * k;
      if (x < -50 || x > w + 50 || y < -50 || y > h + 50) {
        spawn(s, false);
        continue;
      }
      const b = buckets[Math.min(BUCKETS - 1, ((1 - s.z) * BUCKETS) | 0)];
      if (streak) {
        const pk = 0.25 / s.pz;
        b.push(cx + s.x * pk, cy + s.y * pk, x, y);
      } else {
        b.push(x, y);
      }
    }

    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, w, h);
    ctx.lineCap = 'round';
    for (let i = 0; i < BUCKETS; i++) {
      const b = buckets[i];
      if (!b.length) continue;
      const size = 0.3 + ((i + 0.5) / BUCKETS) * 1.5;
      if (streak) {
        ctx.strokeStyle = styles[i];
        ctx.lineWidth = size;
        ctx.beginPath();
        for (let j = 0; j < b.length; j += 4) {
          ctx.moveTo(b[j], b[j + 1]);
          ctx.lineTo(b[j + 2], b[j + 3]);
        }
        ctx.stroke();
      } else {
        ctx.fillStyle = styles[i];
        ctx.beginPath();
        for (let j = 0; j < b.length; j += 2) ctx.rect(b[j], b[j + 1], size, size);
        ctx.fill();
      }
    }
  }

  function tick(now: number) {
    if (!running) return;
    requestAnimationFrame(tick);
    // Açılış hızından seyir hızına yumuşak iniş
    speed += (CRUISE - speed) * 0.035;
    boost *= 0.9;
    if (++frame % SKIP) return;
    // Atlanan kareleri telafi et ki hız SKIP'ten bağımsız kalsın
    draw((speed + boost) * SKIP);
  }

  readColors();
  resize();
  if (!animate) draw(0);

  // Mobilde adres çubuğu açılıp kapanınca yükseklik değişir; bunun için yıldızları baştan kurma
  window.addEventListener(
    'resize',
    () => {
      if (window.innerWidth === w && Math.abs(window.innerHeight - h) < 160) return;
      resize();
      if (!animate) draw(0);
    },
    { passive: true },
  );
  window.addEventListener('themechange', () => {
    readColors();
    if (!animate) draw(0);
  });

  if (animate) {
    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;
        const d = Math.abs(y - lastScrollY);
        lastScrollY = y;
        // Scroll'da hafifçe ileri atıl; üst sınır çizgileşme eşiğinin altında → ışık hızına geçmez
        boost = Math.min(Math.max(boost, d * 0.00004), STREAK * 0.6);
      },
      { passive: true },
    );
    document.addEventListener('visibilitychange', () => {
      running = !document.hidden;
      if (running) requestAnimationFrame(tick);
    });
    requestAnimationFrame(tick);
  }
</script>

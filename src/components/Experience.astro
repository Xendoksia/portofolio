---
import { getContent } from '../data/content';
import { getLang, ui } from '../i18n';

const lang = getLang(Astro.currentLocale);
const { experience } = getContent(lang);
const t = ui[lang];
---

<section id="experience">
  <div class="container">
    <p class="section-label" data-reveal>{t.experience.label}</p>
    <h2 class="section-title" data-reveal>{t.experience.title}</h2>

    <ol class="timeline" data-timeline>
      <!-- Scroll ile dolan ışın -->
      <span class="timeline__track" aria-hidden="true"><span class="timeline__beam" data-beam></span></span>

      {
        experience.map((job) => (
          <li class="timeline__item" data-reveal>
            <span class="timeline__node" aria-hidden="true" />
            <div class="card timeline__card">
              <div class="timeline__head">
                <div>
                  <h3>{job.role}</h3>
                  <p class="timeline__company">
                    {job.company} <span>· {job.place}</span>
                  </p>
                </div>
                <span class="chip">{job.date}</span>
              </div>
              <ul>
                {job.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 44px;
    display: grid;
    gap: 22px;
  }
  .timeline__track {
    position: absolute;
    left: 11px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    border-radius: 2px;
    background: var(--border);
  }
  .timeline__beam {
    position: absolute;
    inset: 0;
    border-radius: 2px;
    background: #fff;
    box-shadow: var(--glow);
    transform-origin: top;
  }
  html.anim .timeline__beam {
    transform: scaleY(0);
  }
  .timeline__item {
    position: relative;
  }
  .timeline__node {
    position: absolute;
    left: -39px;
    top: 30px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
    box-shadow: 0 0 12px var(--accent-soft);
  }
  .timeline__card {
    padding: clamp(20px, 3vw, 30px);
    transition: border-color 0.3s;
  }
  .timeline__card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }
  .timeline__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px 20px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  h3 {
    margin: 0 0 4px;
    font-size: 1.2rem;
    font-weight: 600;
  }
  .timeline__company {
    margin: 0;
    color: var(--gold);
    font-weight: 500;
  }
  .timeline__company span {
    color: var(--muted);
    font-weight: 400;
  }
  .timeline__card ul {
    margin: 0;
    padding-left: 18px;
    color: var(--muted);
  }
  .timeline__card li + li {
    margin-top: 6px;
  }
  .timeline__card li::marker {
    color: var(--accent);
  }
  @media (max-width: 600px) {
    .timeline {
      padding-left: 30px;
    }
    .timeline__track {
      left: 5px;
    }
    .timeline__node {
      left: -30px;
    }
  }
</style>

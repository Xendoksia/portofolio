---
import { getContent } from '../data/content';
import { getLang, ui } from '../i18n';

const lang = getLang(Astro.currentLocale);
const { profile } = getContent(lang);
const t = ui[lang].contact;
const year = new Date().getFullYear();
---

<section id="contact" class="contact">
  <div class="container contact__grid">
    <div class="contact__intro">
      <p class="section-label" data-reveal>{t.label}</p>
      <h2 class="contact__title" data-reveal>
        {t.title[0]}<span>{t.title[1]}</span>{t.title[2]}
      </h2>
      <p class="contact__text" data-reveal>
        {t.text}
      </p>
    </div>

    {
      profile.contactFormKey ? (
        <form class="cform card" id="contact-form" data-reveal novalidate>
          <p class="cform__bar mono" aria-hidden="true">
            <span class="cform__signal"></span>
            <span class="side-dark">{t.barDark[0]} <em>{t.barDark[1]}</em></span>
            <span class="side-light">{t.barLight[0]} <em>{t.barLight[1]}</em></span>
          </p>
          <input type="hidden" name="access_key" value={profile.contactFormKey} />
          <input type="hidden" name="subject" value={`New message from your portfolio${lang === 'en' ? '' : ` (${lang.toUpperCase()})`}`} />
          <input type="hidden" name="from_name" value="Portfolio contact form" />
          {/* Spam tuzağı: insanlar görmez, botlar doldurur → Web3Forms reddeder */}
          <input type="checkbox" name="botcheck" class="cform__trap" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="cform__row">
            <label class="cform__field">
              <span class="mono">{t.name}</span>
              <input name="name" type="text" autocomplete="name" required maxlength="100" />
            </label>
            <label class="cform__field">
              <span class="mono">{t.email}</span>
              <input name="email" type="email" autocomplete="email" required maxlength="200" />
            </label>
          </div>
          <label class="cform__field">
            <span class="mono">{t.message}</span>
            <textarea
              name="message"
              rows="5"
              required
              maxlength="5000"
              data-dark={t.placeholderDark}
              data-light={t.placeholderLight}></textarea>
          </label>
          <div class="cform__foot">
            <p class="cform__status" id="cform-status" role="status" aria-live="polite"></p>
            <button class="btn btn--primary" type="submit" id="cform-send">
              <span id="cform-label">{t.send}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12h15m0 0-6-6m6 6-6 6"></path></svg>
            </button>
          </div>
        </form>
      ) : (
        <div class="contact__mail" data-reveal>
          <a class="contact__email" href={`mailto:${profile.email}`}>{profile.email}</a>
          <button class="btn" type="button" id="copy-email" data-email={profile.email}>
            <span id="copy-label">{t.copy}</span>
          </button>
        </div>
      )
    }

    <div class="contact__more">
      {
        profile.contactFormKey && (
          <p class="contact__direct" data-reveal>
            {t.direct} <a href={`mailto:${profile.email}`}>{profile.email}</a>
            <button class="contact__copy mono" type="button" id="copy-email" data-email={profile.email}>
              <span id="copy-label">{t.copy}</span>
            </button>
          </p>
        )
      }
      <ul class="contact__links" data-reveal>
        <li>
          <a class="btn" href={profile.github} target="_blank" rel="noopener" data-magnetic>
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2 0-.4-.5-1.6.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.7 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z"></path></svg>
            GitHub
          </a>
        </li>
        <li>
          <a class="btn" href={profile.linkedin} target="_blank" rel="noopener" data-magnetic>
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.3V9h3.4v1.6h.1c.5-.9 1.6-1.8 3.4-1.8 3.6 0 4.3 2.4 4.3 5.5v6.2ZM5.3 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2ZM7.1 20.5H3.5V9h3.6v11.5ZM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0Z"></path></svg>
            LinkedIn
          </a>
        </li>
        <li>
          <a class="btn btn--primary" href={profile.cv} download data-magnetic>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v12m0 0-5-5m5 5 5-5M5 20h14"></path></svg>
            {t.cv}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <footer class="footer container mono">
    <span>© {year} {profile.name}</span>
    <span class="footer__motto side-dark">{t.footerDark}</span>
    <span class="footer__motto side-light">{t.footerLight}</span>
  </footer>
</section>

<style>
  .contact {
    padding-bottom: 40px;
  }
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'intro form'
      'more form';
    column-gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .contact__intro {
    grid-area: intro;
  }
  .contact__grid > :global(.cform),
  .contact__grid > :global(.contact__mail) {
    grid-area: form;
  }
  .contact__more {
    grid-area: more;
  }
  @media (max-width: 900px) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas: 'intro' 'form' 'more';
    }
  }
  /* Kısa masaüstü ekranı (ör. 1366×768): bölüm + footer tek ekrana sığsın */
  @media (min-width: 901px) and (max-height: 760px) {
    .contact {
      padding-top: 72px;
    }
    .contact .contact__title {
      font-size: 3.4rem;
    }
    .contact .contact__text {
      margin-bottom: 24px;
    }
    .contact .cform {
      gap: 12px;
    }
    .contact .cform textarea {
      min-height: 96px;
    }
    .contact .footer {
      margin-top: 36px;
    }
  }
  .contact__title {
    font-size: clamp(2.6rem, 6vw, 5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    margin: 0 0 22px;
    font-weight: 700;
  }
  .contact__title span {
    color: var(--accent);
    text-shadow: 0 0 30px var(--accent-soft);
  }
  .contact__text {
    max-width: 520px;
    color: var(--muted);
    margin: 0 0 36px;
  }
  .contact__mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
    margin-bottom: 30px;
  }
  .contact__email {
    font-size: clamp(1.15rem, 3.4vw, 2rem);
    font-weight: 500;
    text-decoration: none;
    background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 2px no-repeat;
    transition: background-size 0.4s;
    word-break: break-all;
  }
  .contact__email:hover {
    background-size: 100% 2px;
  }
  /* ---------- İletişim formu ---------- */
  .cform {
    display: grid;
    gap: 16px;
    padding: clamp(18px, 3vw, 28px);
    margin-bottom: 18px;
  }
  /* Üst çubuk: yanıp sönen sinyal ışığı (sadece opacity → compositor, bedava) */
  .cform__bar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 4px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text);
  }
  .cform__bar em {
    font-style: normal;
    color: var(--muted);
  }
  .cform__signal {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    animation: signal 2.4s ease-in-out infinite;
  }
  @keyframes signal {
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cform__signal {
      animation: none;
    }
  }
  .cform textarea::placeholder {
    color: var(--muted);
    opacity: 0.55;
    font-style: italic;
  }
  .cform__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .cform__field {
    display: grid;
    gap: 8px;
  }
  .cform__field span {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .cform input,
  .cform textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    color: var(--text);
    font: 400 15px/1.5 'Space Grotesk', sans-serif;
    transition: border-color 0.25s, box-shadow 0.25s;
  }
  .cform textarea {
    resize: vertical;
    min-height: 130px;
  }
  .cform input:focus,
  .cform textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), 0 0 22px var(--accent-soft);
  }
  .cform :global(.is-invalid) {
    border-color: var(--accent);
  }
  .cform__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .cform__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
  }
  .cform__status {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }
  .cform__status:global(.is-ok) {
    color: var(--gold);
  }
  .cform__status:global(.is-err) {
    color: var(--accent);
  }
  .cform button[disabled] {
    opacity: 0.6;
    cursor: wait;
  }
  .contact__direct {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 0 0 22px;
    font-size: 14px;
    color: var(--muted);
  }
  .contact__direct a {
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
    word-break: break-all;
  }
  .contact__direct a:hover {
    border-color: var(--accent);
  }
  .contact__copy {
    padding: 3px 9px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: none;
    color: var(--muted);
    font-size: 11px;
    cursor: pointer;
  }
  .contact__copy:hover {
    color: var(--text);
    border-color: var(--accent);
  }
  @media (max-width: 600px) {
    /* Üst çubuk: yanıp sönen sinyal ışığı (sadece opacity → compositor, bedava) */
  .cform__bar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 4px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text);
  }
  .cform__bar em {
    font-style: normal;
    color: var(--muted);
  }
  .cform__signal {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    animation: signal 2.4s ease-in-out infinite;
  }
  @keyframes signal {
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cform__signal {
      animation: none;
    }
  }
  .cform textarea::placeholder {
    color: var(--muted);
    opacity: 0.55;
    font-style: italic;
  }
  .cform__row {
      grid-template-columns: 1fr;
    }
    .cform__foot .btn {
      width: 100%;
      justify-content: center;
    }
  }
  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    margin-top: clamp(48px, 6vw, 72px);
    padding-top: 26px;
    border-top: 1px solid var(--border);
    font-size: 12px;
    color: var(--muted);
  }
  .footer__motto {
    color: var(--gold);
  }
</style>

<script>
  import { clientUI } from '../i18n';
  const T = clientUI();

  // ---------- İletişim formu (Web3Forms) ----------
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const status = document.getElementById('cform-status')!;
    const send = document.getElementById('cform-send') as HTMLButtonElement;
    const sendLabel = document.getElementById('cform-label')!;
    const setStatus = (text: string, kind: '' | 'ok' | 'err' = '') => {
      status.textContent = text;
      status.classList.toggle('is-ok', kind === 'ok');
      status.classList.toggle('is-err', kind === 'err');
    };

    // Tarafa göre değişen metinler (dark side = İmparatorluk, light side = Asiler)
    const side = () => (document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');
    const SIDE_TEXT = {
      dark: { ok: T.okDark, err: T.errDark },
      light: { ok: T.okLight, err: T.errLight },
    };
    const message = form.querySelector('textarea')!;
    const syncSide = () => (message.placeholder = message.dataset[side()]!);
    syncSide();
    window.addEventListener('themechange', syncSide);

    form.addEventListener('input', (e) => (e.target as HTMLElement).classList.remove('is-invalid'));
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')];
      const bad = fields.filter((f) => !f.value.trim() || !f.checkValidity());
      fields.forEach((f) => f.classList.toggle('is-invalid', bad.includes(f)));
      if (bad.length) {
        setStatus(bad[0].type === 'email' && bad[0].value ? T.badEmail : T.empty, 'err');
        bad[0].focus();
        return;
      }

      send.disabled = true;
      sendLabel.textContent = T.sending;
      setStatus('');
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) throw new Error(data.message || res.statusText);
        form.reset();
        setStatus(SIDE_TEXT[side()].ok, 'ok');
      } catch {
        setStatus(SIDE_TEXT[side()].err, 'err');
      } finally {
        send.disabled = false;
        sendLabel.textContent = T.send;
      }
    });
  }

  // ---------- E-postayı kopyala ----------
  const btn = document.getElementById('copy-email') as HTMLButtonElement;
  const label = document.getElementById('copy-label')!;
  btn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.email!);
      label.textContent = document.documentElement.dataset.theme === 'light' ? T.copiedLight : T.copiedDark;
    } catch {
      label.textContent = T.copyFailed;
    }
    setTimeout(() => (label.textContent = T.copy), 1800);
  });
</script>

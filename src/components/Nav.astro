---
import { nav, profile } from '../data/content';

interface Props {
  // Alt sayfalarda (örn. /projects) linkler ana sayfaya gider: "/#about"
  base?: string;
  // Alt sayfada vurgulanacak menü öğesi
  active?: string;
}

const { base = '', active } = Astro.props;
---

<header class="nav" data-fixed-active={active ? '' : undefined}>
  <div class="nav__inner container">
    <a href={base ? '/' : '#top'} class="nav__logo mono" aria-label={base ? 'Home' : 'Back to top'}>
      <span class="nav__dot"></span><span>{profile.firstName}<span class="nav__k">.dev</span></span>
    </a>

    <nav aria-label="Main">
      <ul class="nav__links" id="nav-links">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.id === active ? '#top' : `${base}#${item.id}`}
                data-nav={item.id}
                class:list={{ 'is-active': item.id === active }}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__actions">
      <button class="saber" id="theme-toggle" type="button" aria-label="Toggle theme">
        <span class="saber__label mono" id="theme-label">Dark side</span>
        <span class="saber__hilt" aria-hidden="true"><span class="saber__blade"></span></span>
      </button>
      <button class="nav__menu" id="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding-block: 14px;
    transition: background 0.35s, border-color 0.35s, padding 0.35s;
    border-bottom: 1px solid transparent;
  }
  .nav.is-scrolled {
    padding-block: 10px;
    /* blur yok: sabit menünün altındaki içeriği her karede bulanıklaştırmak pahalı */
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    border-color: var(--border);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .nav__logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 500;
    font-size: 15px;
    text-decoration: none;
  }
  .nav__k {
    color: var(--muted);
  }
  .nav__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: var(--glow);
  }
  .nav__links {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__links a {
    display: inline-flex;
    align-items: baseline;
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.25s, background 0.25s;
  }
  .nav__links a:hover,
  .nav__links a.is-active {
    color: var(--text);
    background: var(--surface);
  }
  .nav__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Tema anahtarı: ışın kılıcı */
  .saber {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 7px 12px 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: border-color 0.3s;
  }
  .saber:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .saber__hilt {
    position: relative;
    width: 16px;
    height: 6px;
    border-radius: 2px;
    background: linear-gradient(90deg, #6b6f7a, #c9ccd4 40%, #4b4f58 41%, #9ca0aa);
    margin-right: 30px;
  }
  .saber__blade {
    position: absolute;
    left: 100%;
    top: 1px;
    height: 4px;
    width: 30px;
    border-radius: 0 3px 3px 0;
    background: #fff;
    box-shadow: var(--glow);
    transform-origin: left center;
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .saber.is-igniting .saber__blade {
    transform: scaleX(0);
    transition-duration: 0.18s;
  }

  .nav__menu {
    display: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    cursor: pointer;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
  }
  .nav__menu span {
    width: 16px;
    height: 1.5px;
    background: var(--text);
    transition: transform 0.3s;
  }
  .nav__menu[aria-expanded='true'] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .nav__menu[aria-expanded='true'] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    .nav__menu {
      display: inline-flex;
    }
    .nav__links {
      position: absolute;
      top: calc(100% + 8px);
      left: 16px;
      right: 16px;
      flex-direction: column;
      padding: 10px;
      border-radius: 18px;
      border: 1px solid var(--border);
      background: var(--bg-elev);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity 0.25s, transform 0.25s, visibility 0.25s;
    }
    .nav__links.is-open {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .nav__links a {
      width: 100%;
      padding: 12px 14px;
      font-size: 16px;
    }
  }
  @media (max-width: 420px) {
    .saber__label {
      display: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const header = document.querySelector('.nav') as HTMLElement;
  const toggle = document.getElementById('theme-toggle') as HTMLButtonElement;
  const label = document.getElementById('theme-label')!;
  const menuBtn = document.getElementById('menu-toggle') as HTMLButtonElement;
  const links = document.getElementById('nav-links')!;

  const labelFor = (t: string) => (t === 'dark' ? 'Dark side' : 'Light side');
  label.textContent = labelFor(root.dataset.theme || 'dark');

  function apply(theme: string) {
    root.dataset.theme = theme;
    label.textContent = labelFor(theme);
    try {
      localStorage.setItem('theme', theme);
    } catch {}
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#05060a' : '#1b2232');
    window.dispatchEvent(new Event('themechange'));
  }

  toggle.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Kılıç söner, tema değişir, kılıç yeni renkte yeniden yanar
    toggle.classList.add('is-igniting');
    setTimeout(() => toggle.classList.remove('is-igniting'), 200);

    const doc = document as Document & { startViewTransition?: (cb: () => void) => { ready: Promise<void> } };
    if (!doc.startViewTransition || reduced) {
      apply(next);
      return;
    }
    // Butondan yayılan dairesel tema geçişi
    const r = toggle.getBoundingClientRect();
    const x = r.left + r.width / 2;
    const y = r.top + r.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    const t = doc.startViewTransition(() => apply(next));
    t.ready.then(() => {
      root.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
        { duration: 650, easing: 'cubic-bezier(0.65, 0, 0.35, 1)', pseudoElement: '::view-transition-new(root)' },
      );
    });
  });

  // Mobil menü
  const setMenu = (open: boolean) => {
    links.classList.toggle('is-open', open);
    menuBtn.setAttribute('aria-expanded', String(open));
  };
  menuBtn.addEventListener('click', () => setMenu(!links.classList.contains('is-open')));
  links.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenu(false);
  });

  // Scroll edince arka planlı nav
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 30);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Aktif bölümü vurgula
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        navLinks.forEach((a) => a.classList.toggle('is-active', a.dataset.nav === entry.target.id));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  // Alt sayfada (data-fixed-active) vurgulu öğe sabit kalır; bölüm takibi sadece ana sayfada
  if (!header.hasAttribute('data-fixed-active')) navLinks.forEach((a) => {
    const section = document.getElementById(a.dataset.nav!);
    if (section) io.observe(section);
  });
</script>

---
import { projects, profile } from '../data/content';
import ProjectCard from './ProjectCard.astro';

const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);
---

<section id="projects">
  <div class="container">
    <p class="section-label" data-reveal>Episode III · Projects</p>
    <h2 class="section-title" data-reveal>Selected missions.</h2>

    <div class="featured">
      {featured.map((p, i) => <ProjectCard project={p} big num={i + 1} />)}
    </div>

    <div class="others">
      {others.map((p) => <ProjectCard project={p} />)}
    </div>

    <div class="more" data-reveal>
      <a class="btn btn--primary" href="/projects" data-magnetic>
        All projects in detail
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
      <a class="btn" href={profile.github} target="_blank" rel="noopener" data-magnetic>
        More on GitHub
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M8 7h9v9"></path></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .featured {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 18px;
  }
  .others {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .more {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 44px;
  }
  @media (max-width: 960px) {
    .featured,
    .others {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .featured,
    .others {
      grid-template-columns: 1fr;
    }
  }
</style>

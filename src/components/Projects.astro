---
import { getContent } from '../data/content';
import { getLang, path, ui } from '../i18n';
import ProjectCard from './ProjectCard.astro';

const lang = getLang(Astro.currentLocale);
const { projects, profile } = getContent(lang);
const t = ui[lang].projects;

// Ana sayfada sadece öne çıkanlar; geri kalanı /projects'te. Panel, gizli projelerin adlarını gösterip oraya çağırır.
const featured = projects.filter((p) => p.featured);
const hidden = projects.filter((p) => !p.featured);
const caseCount = projects.filter((p) => p.case).length;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="projects">
  <div class="container">
    <p class="section-label" data-reveal>{t.label}</p>
    <h2 class="section-title" data-reveal>{t.title}</h2>

    <div class="featured">
      {featured.map((p, i) => <ProjectCard project={p} big num={i + 1} />)}
    </div>

    <a class="card hangar" href={path('/projects', lang)} data-reveal data-glow>
      <span class="hangar__saber" aria-hidden="true"></span>
      <div class="hangar__text">
        <p class="hangar__label mono">
          <span>+{pad(hidden.length)}</span> {t.more(caseCount)}
        </p>
        <h3>{t.hangar}</h3>
        <p class="hangar__desc">{t.hangarDesc}</p>
        <ul class="hangar__list" aria-label={t.moreAria}>
          {hidden.map((p) => <li class="mono">{p.title}</li>)}
        </ul>
      </div>
      <span class="hangar__cta">
        {t.all}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </span>
    </a>

    <div class="more" data-reveal>
      <a class="more__gh mono" href={profile.github} target="_blank" rel="noopener">
        {t.github}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M8 7h9v9"></path></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .featured {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 18px;
  }

  /* ---------- /projects'e çağıran panel ---------- */
  .hangar {
    --mx: 50%;
    --my: 50%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(24px, 4vw, 56px);
    padding: clamp(28px, 4vw, 44px);
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    background:
      radial-gradient(ellipse 60% 120% at 100% 50%, var(--accent-soft), transparent 70%),
      color-mix(in srgb, var(--bg-elev) 82%, transparent);
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  /* İmleci takip eden ışık (ProjectCard ile aynı) */
  .hangar::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(420px circle at var(--mx) var(--my), var(--accent-soft), transparent 60%);
    opacity: 0;
    transition: opacity 0.35s;
    pointer-events: none;
  }
  .hangar:hover {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent), 0 24px 60px -30px var(--accent);
  }
  .hangar:hover::before {
    opacity: 1;
  }
  .hangar > :not(.hangar__saber) {
    position: relative;
  }
  /* Üst kenarda ışın kılıcı çizgisi; üstüne gelince boydan boya uzar */
  .hangar__saber {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent), 0 0 2px #fff;
    transform: scaleX(0.28);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hangar:hover .hangar__saber {
    transform: scaleX(1);
  }
  .hangar__label {
    margin: 0 0 12px;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .hangar__label span {
    margin-right: 6px;
    font-size: 15px;
    letter-spacing: 0;
    color: var(--accent);
  }
  .hangar h3 {
    margin: 0 0 10px;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    font-weight: 600;
  }
  .hangar__desc {
    margin: 0 0 18px;
    color: var(--muted);
  }
  .hangar__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hangar__list li {
    padding: 5px 11px;
    border: 1px dashed var(--border);
    border-radius: 999px;
    font-size: 12px;
    color: var(--muted);
    transition: border-color 0.3s, color 0.3s;
  }
  .hangar:hover .hangar__list li {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    color: var(--text);
  }
  /* Büyük ana düğme (kartın tamamı link; bu görsel çağrı) */
  .hangar__cta {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 30px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font: 600 17px/1 'Space Grotesk', sans-serif;
    box-shadow: 0 0 0 1px var(--accent), 0 10px 34px -10px var(--accent);
    transition: box-shadow 0.3s, transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hangar__cta svg {
    width: 20px;
    height: 20px;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .hangar:hover .hangar__cta {
    box-shadow: var(--glow);
    transform: translateY(-2px);
  }
  .hangar:hover .hangar__cta svg {
    transform: translateX(4px);
  }

  .more {
    display: flex;
    justify-content: center;
    margin-top: 22px;
  }
  .more__gh {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.25s;
  }
  .more__gh:hover {
    color: var(--text);
  }
  .more__gh svg {
    width: 14px;
    height: 14px;
  }

  @media (max-width: 960px) {
    .featured {
      grid-template-columns: 1fr 1fr;
    }
    .hangar {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (max-width: 640px) {
    .featured {
      grid-template-columns: 1fr;
    }
    .hangar__cta {
      width: 100%;
      justify-content: center;
    }
  }
</style>

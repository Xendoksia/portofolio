---
import { getContent } from '../data/content';
import { getLang, ui } from '../i18n';

const lang = getLang(Astro.currentLocale);
const { education } = getContent(lang);
const t = ui[lang];
---

<section id="education">
  <div class="container">
    <p class="section-label" data-reveal>{t.education.label}</p>
    <h2 class="section-title" data-reveal>{t.education.title}</h2>

    <div class="edu">
      {
        education.map((e) => (
          <article class="card edu__card" data-reveal>
            <span class="chip">{e.date}</span>
            <h3>{e.school}</h3>
            <p class="edu__degree">{e.degree}</p>
            <p class="edu__place mono">{e.place}</p>
          </article>
        ))
      }
    </div>

    <div class="langs" data-reveal>
      <span class="mono">{t.education.langs}</span>
      <span>{t.education.turkish}</span>
      <span>{t.education.english}</span>
    </div>
  </div>
</section>

<style>
  .edu {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .edu__card {
    padding: 26px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  h3 {
    margin: 6px 0 0;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .edu__degree {
    margin: 0;
    color: var(--muted);
  }
  .edu__place {
    margin: auto 0 0;
    padding-top: 8px;
    font-size: 12px;
    color: var(--gold);
  }
  .langs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    align-items: center;
    margin-top: 28px;
    color: var(--muted);
  }
  .langs .mono {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
  }
  @media (max-width: 860px) {
    .edu {
      grid-template-columns: 1fr;
    }
  }
</style>

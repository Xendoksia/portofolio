---
import Layout from '../layouts/Layout.astro';
import Starfield from '../components/Starfield.astro';
import Nav from '../components/Nav.astro';
import CaseStudy from '../components/CaseStudy.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Contact from '../components/Contact.astro';
import { projects, profile } from '../data/content';

const cases = projects.filter((p) => p.case).sort((a, b) => a.case!.order - b.case!.order);
const others = projects.filter((p) => !p.case);
---

<Layout
  title={`Projects — ${profile.name}`}
  description="Detailed case studies of my AI, computer vision and NLP projects, plus smaller experiments."
>
  <Starfield />
  <Nav base="/" active="projects" />
  <main>
    <section class="phead" id="top">
      <div class="container">
        <a class="phead__back mono" href="/#projects" data-reveal>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
          Back to home
        </a>
        <p class="section-label" data-reveal>Episode III · Projects</p>
        <h1 class="phead__title" data-reveal>Mission archive.</h1>
        <p class="phead__intro" data-reveal>
          A closer look at the projects I'm proudest of: the problem, what I built, and the numbers behind it.
          Smaller experiments are further down.
        </p>
      </div>
    </section>

    {
      cases.map((p, i) => (
        <section class="case-section">
          <div class="container">
            <CaseStudy project={p} num={i + 1} flip={i % 2 === 1} />
          </div>
        </section>
      ))
    }

    <section id="more">
      <div class="container">
        <p class="section-label" data-reveal>Side missions</p>
        <h2 class="section-title" data-reveal>More projects.</h2>
        <div class="others">
          {others.map((p) => <ProjectCard project={p} />)}
        </div>
        <div class="more" data-reveal>
          <a class="btn" href={profile.github} target="_blank" rel="noopener" data-magnetic>
            More on GitHub
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M8 7h9v9"></path></svg>
          </a>
        </div>
      </div>
    </section>

    <Contact />
  </main>

  <!-- Fotoğraf kutusuna tıklayınca açılan büyük görünüm -->
  <dialog class="lightbox" id="lightbox" aria-label="Screenshot">
    <button class="lightbox__close" type="button" aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6 6 18"></path></svg>
    </button>
    <div class="lightbox__stage">
      <div class="lightbox__imgs" id="lightbox-imgs"></div>
      <button class="lightbox__nav lightbox__nav--prev" type="button" data-step="-1" aria-label="Previous screenshot">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"></path></svg>
      </button>
      <button class="lightbox__nav lightbox__nav--next" type="button" data-step="1" aria-label="Next screenshot">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"></path></svg>
      </button>
    </div>
    <div class="lightbox__foot">
      <p class="lightbox__caption" id="lightbox-caption" aria-live="polite"></p>
      <p class="lightbox__count mono" id="lightbox-count"></p>
    </div>
  </dialog>
</Layout>

<style>
  .phead {
    padding-block: clamp(130px, 18vw, 190px) clamp(40px, 6vw, 70px);
  }
  .phead__back {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 8px;
    margin-bottom: 34px;
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.25s;
  }
  .phead__back:hover {
    color: var(--text);
  }
  .phead__back svg {
    width: 16px;
    height: 16px;
    transition: transform 0.25s;
  }
  .phead__back:hover svg {
    transform: translateX(-3px);
  }
  .phead__title {
    margin: 0 0 20px;
    font-size: clamp(2.8rem, 8vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 700;
  }
  .phead__intro {
    max-width: 600px;
    margin: 0;
    color: var(--muted);
    font-size: 1.08rem;
  }
  .case-section {
    padding-block: clamp(18px, 3vw, 32px);
  }
  .others {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 18px;
  }
  .more {
    display: flex;
    justify-content: center;
    margin-top: 44px;
  }

  /* ---------- Lightbox ---------- */
  /* Sabit yükseklik (geçişte pencere boyu ve oklar zıplamaz); görsel alanı açıklamadan kalan yeri alır,
     açıklama kaç satır olursa olsun kesilmez. dvh: mobilde adres çubuğu hariç gerçek görünür yükseklik */
  .lightbox {
    width: min(1400px, 94vw);
    height: 92vh;
    height: 92dvh;
    max-height: none;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--bg-elev);
    color: var(--text);
    overflow: hidden;
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    animation: lb-in 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .lightbox::backdrop {
    background: rgba(2, 3, 8, 0.82);
  }
  @keyframes lb-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }
  .lightbox__stage {
    position: relative;
    min-height: 0;
  }
  .lightbox__imgs {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    background: var(--bg);
  }
  .lightbox__imgs :global(img) {
    display: block;
    min-width: 0;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  /* telefon slaytı: 3 ekran yan yana */
  .lightbox__imgs:global(.lightbox__imgs--phones) {
    padding: 16px;
  }
  .lightbox__imgs:global(.lightbox__imgs--phones) :global(img) {
    border-radius: 12px;
  }
  /* Dik telefon ekranı: pencere içeriği kadar uzar (yatay görselin altında/üstünde boş alan kalmaz) */
  @media (orientation: portrait) and (max-width: 700px) {
    .lightbox {
      height: fit-content; /* auto, modal dialog'da ekranı doldurur */
      max-height: 92dvh;
    }
    .lightbox[open] {
      grid-template-rows: auto auto;
    }
    .lightbox__imgs {
      position: static;
      gap: 8px;
      padding-top: 64px; /* kapatma düğmesi görselin üstüne binmesin */
    }
    .lightbox__imgs :global(img) {
      max-height: calc(92dvh - 220px);
    }
    .lightbox__imgs:global(.lightbox__imgs--phones) {
      padding: 64px 10px 12px;
    }
    .lightbox__imgs:global(.lightbox__imgs--phones) :global(img) {
      border-radius: 8px;
    }
    .lightbox__caption {
      font-size: 13px;
    }
  }
  .lightbox__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
  }
  .lightbox__caption {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }
  .lightbox__count {
    margin: 0;
    flex: none;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .lightbox__count :global(b) {
    font-weight: 500;
    color: var(--accent);
  }
  /* Önceki / sonraki: yanlarda yuvarlak düğme, üstüne gelince ışın parıltısı */
  .lightbox__nav {
    position: absolute;
    top: 50%;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    color: var(--text);
    cursor: pointer;
    transform: translateY(-50%);
    transition: border-color 0.2s, box-shadow 0.2s, color 0.2s, transform 0.2s;
  }
  .lightbox__nav--prev {
    left: 14px;
  }
  .lightbox__nav--next {
    right: 14px;
  }
  .lightbox__nav svg {
    width: 22px;
    height: 22px;
  }
  .lightbox__nav:hover,
  .lightbox__nav:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent), 0 0 22px var(--accent-soft);
    outline: none;
  }
  .lightbox__nav--prev:hover {
    transform: translate(-2px, -50%);
  }
  .lightbox__nav--next:hover {
    transform: translate(2px, -50%);
  }
  .lightbox__nav:active {
    transform: translateY(-50%) scale(0.94);
  }
  .lightbox:global(.is-single) .lightbox__nav,
  .lightbox:global(.is-single) .lightbox__count {
    display: none;
  }
  @media (max-width: 600px) {
    .lightbox__nav {
      width: 40px;
      height: 40px;
    }
    .lightbox__nav--prev {
      left: 8px;
    }
    .lightbox__nav--next {
      right: 8px;
    }
  }
  .lightbox__close {
    position: absolute;
    z-index: 2; /* görsel katmanının üstünde kalsın */
    top: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    color: var(--text);
    cursor: pointer;
  }
  .lightbox__close svg {
    width: 18px;
    height: 18px;
  }
  .lightbox__close:hover {
    border-color: var(--accent);
  }
</style>

<script>
  import '../scripts/animations';

  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const imgs = document.getElementById('lightbox-imgs')!;
  const caption = document.getElementById('lightbox-caption')!;
  const count = document.getElementById('lightbox-count')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pad = (n: number) => String(n).padStart(2, '0');

  // Açık galeri: hangi vaka kutusu, kaçıncı slayt
  let box: HTMLElement | null = null;
  let slides: HTMLElement[] = [];
  let index = 0;

  const fullSrc = (s: HTMLImageElement) => s.dataset.full || s.currentSrc;
  // Komşu slaytların büyük hallerini önceden yükle → geçiş anında bekleme olmasın
  const preload = (i: number) =>
    slides[(i + slides.length) % slides.length]?.querySelectorAll<HTMLImageElement>('.shot').forEach((s) => {
      new Image().src = fullSrc(s);
    });

  function show(i: number, dir = 0) {
    index = (i + slides.length) % slides.length;
    const slide = slides[index];
    const shots = [...slide.querySelectorAll<HTMLImageElement>('.shot')];
    imgs.classList.toggle('lightbox__imgs--phones', slide.classList.contains('slide--phones'));
    imgs.replaceChildren(
      ...shots.map((s) => {
        const img = new Image();
        img.src = fullSrc(s);
        img.alt = s.alt;
        return img;
      }),
    );
    caption.textContent = slide.dataset.caption!;
    count.innerHTML = `<b>${pad(index + 1)}</b> / ${pad(slides.length)}`;
    // Kısa kayma + belirme (beklemeden, hemen başlar)
    if (dir && !reduce)
      imgs.animate(
        [{ opacity: 0.35, transform: `translateX(${dir * 28}px)` }, { opacity: 1, transform: 'none' }],
        { duration: 220, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' },
      );
    // Sayfadaki kutu da aynı slayda geçsin (kapatınca kaldığın yerde)
    box?.querySelector<HTMLButtonElement>(`.thumb[data-index="${index}"]`)?.click();
    preload(index + 1);
    preload(index - 1);
  }
  const step = (d: number) => slides.length > 1 && show(index + d, d);

  document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((btn) => {
    btn.addEventListener('click', () => {
      box = btn.closest('.case');
      slides = [...btn.querySelectorAll<HTMLElement>('.slide')];
      dialog.classList.toggle('is-single', slides.length < 2);
      show(Math.max(0, slides.findIndex((s) => s.classList.contains('is-active'))));
      dialog.showModal();
    });
  });

  dialog.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) =>
    b.addEventListener('click', () => step(Number(b.dataset.step))),
  );
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') step(1);
    else if (e.key === 'ArrowLeft') step(-1);
    else return;
    e.preventDefault();
  });
  // Dokunmatik: yatay kaydırma ile geçiş
  let tx = 0;
  let ty = 0;
  imgs.addEventListener('touchstart', (e) => ((tx = e.touches[0].clientX), (ty = e.touches[0].clientY)), { passive: true });
  imgs.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - tx;
    const dy = e.changedTouches[0].clientY - ty;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) step(dx < 0 ? 1 : -1);
  });

  dialog.querySelector('.lightbox__close')!.addEventListener('click', () => dialog.close());
  // Arka plana tıklayınca kapat
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
